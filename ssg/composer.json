{
    "name": "nextcloud/collectives-ssg-renderer",
    "description": "Static site renderer microservice for Nextcloud Collectives",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "league/commonmark": "^2.7"
    },
    "autoload": {
