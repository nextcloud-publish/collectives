// These values are injected by the Collectives PHP backend at build time.
// They demonstrate how a "scope" of a collective could parametrise the site.
const siteTitle = process.env.COLLECTIVES_SSG_TITLE || 'Collectives'
const generatedBy = process.env.COLLECTIVES_SSG_USER || 'Collectives'
const buildTime = new Date().toLocaleString('en-GB', { timeZone: 'UTC' }) + ' UTC'

const pages = [
	{ title: 'Welcome', body: 'This page was rendered statically by Astro.' },
	{ title: 'How it works', body: 'The Collectives backend runs `astro build` and stores the output as plain HTML files.' },
	{ title: 'Next steps', body: 'Later this will export selected pages of a collective instead of this sample content.' },
]
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content="Astro + Nextcloud Collectives" />
		<title>{siteTitle} — Static site</title>
		<style>
			:root { color-scheme: light dark; }
			* { box-sizing: border-box; }
			body {
				margin: 0;
				font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
				line-height: 1.6;
				color: #1a1a1a;
				background: #f5f6f8;
			}
			.hero {
				background: linear-gradient(135deg, #0082c9, #00b0ff);
				color: #fff;
				padding: 4rem 1.5rem 3rem;
				text-align: center;
			}
			.hero h1 { margin: 0 0 .5rem; font-size: clamp(2rem, 5vw, 3rem); }
			.hero p { margin: 0; opacity: .9; }
			main { max-width: 820px; margin: -2rem auto 3rem; padding: 0 1.5rem; }
			.cards { display: grid; gap: 1rem; }
			.card {
				background: #fff;
				border-radius: 12px;
				padding: 1.25rem 1.5rem;
				box-shadow: 0 4px 16px rgba(0,0,0,.06);
			}
			.card h2 { margin: 0 0 .25rem; font-size: 1.15rem; }
			.card p { margin: 0; color: #444; }
			footer {
				text-align: center;
				padding: 2rem 1.5rem;
				color: #777;
				font-size: .85rem;
			}
			@media (prefers-color-scheme: dark) {
				body { background: #181818; color: #eee; }
				.card { background: #242424; box-shadow: none; }
				.card p { color: #bbb; }
			}
		</style>
	</head>
	<body>
		<header class="hero">
			<h1>⭐ {siteTitle}</h1>
			<p>A static site generated with Astro from Nextcloud Collectives</p>
		</header>
		<main>
			<div class="cards">
				{pages.map((page) => (
					<article class="card">
						<h2>{page.title}</h2>
						<p>{page.body}</p>
					</article>
				))}
			</div>
		</main>
		<footer>
			Generated by {generatedBy} · {buildTime}
		</footer>
	</body>
</html>
